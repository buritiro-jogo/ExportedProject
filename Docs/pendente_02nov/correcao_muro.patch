@@ -113,6 +113,32 @@ public static class FBWorld
 		return true;
 	}
 
+	// física 02/11: o ClearLine usa raios finos (0,6 m e 1,5 m de altura). Para cortar canto do caminho do NavMesh isso
+	// não basta: na ponta de um muro o raio passa a poucos centímetros e a cápsula do personagem (raio 0,3 + pele 0,08)
+	// bate e fica empurrando o muro (o piloto travou assim no muro grafitado da R. Carmelo, Praça do PT). Este teste
+	// exige também linha livre 0,4 m para cada lado. Só é mais rígido que o ClearLine (nunca libera o que ele bloqueia).
+	// CorpoLargo = false volta ao corte de canto antigo (para teste A/B).
+	public static bool CorpoLargo = true;
+
+	public static bool ClearLineLarga(Vector3 a, Vector3 b, float meia = 0.4f)
+	{
+		if (!ClearLine(a, b))
+		{
+			return false;
+		}
+		if (!CorpoLargo)
+		{
+			return true;
+		}
+		Vector3 d = (b - a).Flat();
+		if (d.sqrMagnitude < 0.0001f)
+		{
+			return true;
+		}
+		Vector3 lado = Vector3.Cross(Vector3.up, d.normalized) * meia;
+		return ClearLine(a + lado, b + lado) && ClearLine(a - lado, b - lado);
+	}
+
